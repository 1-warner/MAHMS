# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# PostgreSQL connection string.
# Local Docker:   postgres://mahms:mahms@localhost:5432/mahms
# Managed host:   taken from the host's dashboard (Render, Railway, Fly.io, Supabase)
DATABASE_URL=postgres://mahms:mahms@localhost:5432/mahms

# Set to "require" when the database is a managed one that insists on TLS.
# PGSSL=require

# Port the API listens on. Managed hosts set this themselves.
PORT=3000

# Firebase service account, used to verify the ID token the app sends.
# Either a path to the JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# or the same JSON on one line (for hosts that only offer environment variables):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Which website origins may call the API from a browser. Comma-separated, or * for the demo.
# ALLOWED_ORIGIN=https://mahms-web.example.com

# DO NOT SET THIS ON A DEPLOYED SERVER.
# MAHMS_AUTH_MODE=test makes the API accept the stub token "Bearer test:<email>" instead of a
# real Firebase token. It exists only so `npm test` and the CI workflow can run the route
# tests without a service account, and it refuses to work when NODE_ENV=production.
# MAHMS_AUTH_MODE=test
